<div class="t-banner-wrapper">
  <div class="t-banner-main">
    <h1 class="t-banner-heading">{{ section.settings.heading }}</h1>
    <p class="t-banner-sub">{{ section.settings.subtext }}</p>
    
    <div class="t-banner-image">
      {% if section.settings.banner_image != blank %}
        <picture>
          {% if section.settings.mobile_image != blank %}
            <source media="(max-width: 767px)" srcset="{{ section.settings.mobile_image | img_url: 'master' }}">
          {% endif %}
          <img src="{{ section.settings.banner_image | img_url: 'master' }}" alt="{{ section.settings.heading }}">
        </picture>
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>

    <a href="{{ section.settings.btn_link }}" class="t-banner-btn">
      {{ section.settings.btn_label }} <span class="arrow-icon">&rarr;</span>
    </a>
  </div>
  
  <div class="t-banner-footer">
    <p>{{ section.settings.bottom_text }}</p>
  </div>
</div>

<style>
  .t-banner-wrapper {
    width: 100%;
    background-color: #ffffff;
    font-family: sans-serif;
    overflow: hidden;
  }
  .t-banner-main {
    display: grid;
    grid-template-columns: 1fr;
    position: relative;
  }
  
  /* الموبايل: الكلام فوق، ثم الصورة، ثم الزرار راكب على الصورة */
  .t-banner-heading {
    grid-column: 1;
    grid-row: 1;
    text-align: center;
    font-size: 32px;
    font-weight: 600;
    margin: 40px 20px 15px 20px;
    color: #000000;
    z-index: 2;
  }
  .t-banner-sub {
    grid-column: 1;
    grid-row: 2;
    text-align: center;
    font-size: 16px;
    line-height: 1.5;
    margin: 0 20px 30px 20px;
    color: #000000;
    z-index: 2;
  }
  .t-banner-image {
    grid-column: 1;
    grid-row: 3; /* الصورة في الصف التالت */
    width: 100%;
    display: flex;
    z-index: 1;
  }
  .t-banner-image img, .t-banner-image svg {
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .t-banner-btn {
    grid-column: 1;
    grid-row: 3; /* الزرار في نفس الصف التالت عشان يركب فوق الصورة */
    justify-self: center;
    align-self: end; /* ينزل لآخر الصورة من تحت */
    margin-bottom: 15%; /* مسافة من حافة الصورة السفلية */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #000000;
    color: #ffffff;
    text-decoration: none;
    padding: 14px 28px;
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    z-index: 3;
    transition: background-color 0.3s ease;
  }
  .t-banner-btn:hover {
    background-color: #333333;
  }
  .t-banner-btn .arrow-icon {
    margin-left: 12px;
    transition: transform 0.3s ease;
  }
  .t-banner-btn:hover .arrow-icon {
    transform: translateX(6px);
  }
  
  .t-banner-footer {
    background-color: #f5f5f5;
    text-align: center;
    padding: 15px 20px;
    font-size: 11px;
    letter-spacing: 1px;
    color: #000000;
    border-top: 1px solid #eaeaea;
  }
  .t-banner-footer p {
    margin: 0;
  }

  /* الديسك توب: الصورة خلفية كاملة، والكلام والزرار على الشمال */
  @media screen and (min-width: 768px) {
    .t-banner-main {
      padding: 80px 5%;
      min-height: 550px;
    }
    .t-banner-image {
      grid-row: 1 / span 3;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }
    .t-banner-image img {
      height: 100%;
      object-position: right center; /* رمي الرسمة ناحية اليمين شوية */
    }
    .t-banner-heading {
      grid-column: 1;
      grid-row: 1;
      text-align: left;
      margin: 0 0 15px 0;
      font-size: 48px;
      justify-self: start;
      align-self: end;
      max-width: 50%;
    }
    .t-banner-sub {
      grid-column: 1;
      grid-row: 2;
      text-align: left;
      margin: 0 0 30px 0;
      justify-self: start;
      max-width: 450px;
    }
    .t-banner-btn {
      grid-column: 1;
      grid-row: 3;
      justify-self: start;
      align-self: start;
      margin-bottom: 0;
    }
  }
</style>