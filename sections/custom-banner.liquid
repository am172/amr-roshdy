{% schema %}
{
  "name": "Custom Banner",
  "tag": "section",
  "class": "t-banner-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Desktop Banner Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Banner Image"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom Bar Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}

<div class="t-banner-wrapper">
  <div class="t-banner-main">
    <div class="t-banner-image">
      {% if section.settings.banner_image != blank %}
        <picture>
          {% if section.settings.mobile_image != blank %}
            <source media="(max-width: 767px)" srcset="{{ section.settings.mobile_image | img_url: 'master' }}">
          {% endif %}
          <img src="{{ section.settings.banner_image | img_url: 'master' }}" alt="{{ section.settings.heading }}">
        </picture>
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>
    <div class="t-banner-content-box">
      <h1 class="t-banner-heading">{{ section.settings.heading }}</h1>
      <p class="t-banner-sub">{{ section.settings.subtext }}</p>
      <a href="{{ section.settings.btn_link }}" class="t-banner-btn">
        {{ section.settings.btn_label }} <span class="arrow-icon">&rarr;</span>
      </a>
    </div>
  </div>
  <div class="t-banner-footer">
    <p>{{ section.settings.bottom_text }}</p>
  </div>
</div>

<style>
  .t-banner-wrapper {
    width: 100%;
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
    font-family: sans-serif;
    overflow: hidden;
  }
  .t-banner-main {
    display: flex;
    flex-direction: column-reverse;
  }
  .t-banner-image {
    width: 100%;
    display: flex;
  }
  .t-banner-image img, .t-banner-image svg {
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .t-banner-content-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 40px 20px 10px 20px;
  }
  .t-banner-heading {
    font-size: 32px;
    font-weight: 600;
    margin: 0 0 15px 0;
    color: #000000;
  }
  .t-banner-sub {
    font-size: 16px;
    line-height: 1.5;
    margin: 0 0 20px 0;
    color: #000000;
  }
  .t-banner-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #000000;
    color: #ffffff;
    text-decoration: none;
    padding: 14px 28px;
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    z-index: 10;
    transition: background-color 0.3s ease;
  }
  .t-banner-btn:hover {
    background-color: #333333;
  }
  .t-banner-btn .arrow-icon {
    margin-left: 12px;
    transition: transform 0.3s ease;
  }
  .t-banner-btn:hover .arrow-icon {
    transform: translateX(6px);
  }
  .t-banner-footer {
    background-color: #f5f5f5;
    text-align: center;
    padding: 15px 20px;
    font-size: 11px;
    letter-spacing: 1px;
    color: #000000;
    border-top: 1px solid #eaeaea;
  }
  .t-banner-footer p {
    margin: 0;
  }

  @media screen and (min-width: 768px) {
    .t-banner-main {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-rows: 1fr;
      min-height: 500px;
    }
    .t-banner-image {
      grid-column: 1 / -1;
      grid-row: 1 / -1;
      z-index: 1;
    }
    .t-banner-image img {
      height: 100%;
      object-position: center;
    }
    .t-banner-content-box {
      grid-column: 1 / -1;
      grid-row: 1 / -1;
      z-index: 2;
      align-self: end;
      justify-self: start;
      text-align: left;
      align-items: flex-start;
      padding: 40px 5%;
      max-width: 50%;
    }
    .t-banner-heading {
      font-size: 48px;
    }
  }
</style>