{% schema %}
{
  "name": "Custom Banner",
  "tag": "section",
  "class": "t-banner-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Desktop Banner Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Banner Image"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom Bar Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}

<div class="t-banner-wrapper">
  <div class="t-banner-main">
    <div class="t-banner-text-box">
      <h1 class="t-banner-heading">{{ section.settings.heading }}</h1>
      <p class="t-banner-sub">{{ section.settings.subtext }}</p>
    </div>
    
    <div class="t-banner-image">
      {% if section.settings.banner_image != blank %}
        <picture>
          {% if section.settings.mobile_image != blank %}
            <source media="(max-width: 767px)" srcset="{{ section.settings.mobile_image | img_url: 'master' }}">
          {% endif %}
          <img src="{{ section.settings.banner_image | img_url: 'master' }}" alt="{{ section.settings.heading }}">
        </picture>
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>

    <a href="{{ section.settings.btn_link }}" class="t-anim-banner-btn">
      <span class="t-btn-text">{{ section.settings.btn_label }}</span>
      <span class="t-btn-arrow">&rarr;</span>
    </a>
  </div>
  
  <div class="t-banner-footer">
    <p>{{ section.settings.bottom_text }}</p>
  </div>
</div>

<style>
  .t-banner-wrapper {
    width: 100%;
    background-color: #ffffff;
    font-family: sans-serif;
    overflow: hidden;
  }
  .t-banner-main {
    display: grid;
    grid-template-columns: 1fr;
    position: relative;
  }
  .t-banner-text-box {
    grid-column: 1;
    grid-row: 1;
    text-align: center;
    padding: 40px 20px 30px 20px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .t-banner-heading {
    font-size: 32px;
    font-weight: 600;
    margin: 0 0 15px 0;
    color: #000000;
  }
  .t-banner-sub {
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
    color: #000000;
    max-width: 300px; /* ده اللي بيلم النص في الموبايل زي الفيجما */
  }
  .t-banner-image {
    grid-column: 1;
    grid-row: 2;
    width: 100%;
    display: flex;
    z-index: 1;
  }
  .t-banner-image picture {
    width: 100%;
    display: flex;
  }
  .t-banner-image img, .t-banner-image svg {
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .t-anim-banner-btn {
    grid-column: 1;
    grid-row: 2;
    justify-self: center;
    align-self: end;
    margin-bottom: 30px;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #000000;
    color: #ffffff;
    text-decoration: none;
    padding: 14px 32px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    overflow: hidden;
    z-index: 3;
    border: none;
    cursor: pointer;
  }
  .t-anim-banner-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0%;
    height: 100%;
    background-color: #FFEE32;
    transition: width 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    z-index: -1;
  }
  .t-anim-banner-btn:hover::before {
    width: 100%;
  }
  .t-btn-text, .t-btn-arrow {
    position: relative;
    z-index: 1;
    transition: color 0.4s ease;
  }
  .t-anim-banner-btn:hover .t-btn-text,
  .t-anim-banner-btn:hover .t-btn-arrow {
    color: #000000;
  }
  .t-btn-arrow {
    margin-left: 10px;
    transition: transform 0.3s ease, color 0.4s ease;
  }
  .t-anim-banner-btn:hover .t-btn-arrow {
    transform: translateX(5px);
  }
  .t-banner-footer {
    background-color: #f5f5f5;
    text-align: center;
    padding: 15px 20px;
    font-size: 11px;
    letter-spacing: 1px;
    color: #000000;
    border-top: 1px solid #eaeaea;
  }
  .t-banner-footer p {
    margin: 0;
  }

  /* تنسيق الديسك توب */
  @media screen and (min-width: 768px) {
    .t-banner-main {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      padding: 80px 5%;
      min-height: 550px;
    }
    .t-banner-image {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }
    .t-banner-image img {
      height: 100%;
      object-position: center;
    }
    .t-banner-text-box {
      position: relative;
      z-index: 2;
      padding: 0;
      max-width: 45%;
      align-items: flex-start;
      text-align: left;
    }
    .t-banner-sub {
      max-width: 100%; 
    }
    .t-banner-heading {
      font-size: 48px;
    }
    .t-anim-banner-btn {
      position: relative;
      z-index: 2;
      align-self: flex-start;
      margin-top: 25px;
      margin-bottom: 0;
    }
  }
</style>