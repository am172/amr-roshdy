{% schema %}
{
  "name": "Tisso Wild Grid",
  "tag": "section",
  "class": "t-wild-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    },
    {
      "type": "product",
      "id": "product_4",
      "label": "Product 4"
    },
    {
      "type": "product",
      "id": "product_5",
      "label": "Product 5"
    },
    {
      "type": "product",
      "id": "product_6",
      "label": "Product 6"
    }
  ],
  "presets": [
    {
      "name": "Tisso Wild Grid"
    }
  ]
}
{% endschema %}

<section class="t-wild-section">
  <div class="t-wild-container">
    {% if section.settings.heading != blank %}
      <h2 class="t-wild-title">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="t-wild-grid">
      {% assign products_array = "product_1,product_2,product_3,product_4,product_5,product_6" | split: "," %}
      
      {% for prod_key in products_array %}
        {% assign prod = section.settings[prod_key] %}
        {% if prod != blank %}
          <div class="t-wild-card" data-product-id="{{ prod.id }}">
            <div class="t-wild-image-wrapper">
              {% if prod.featured_image != blank %}
                <img src="{{ prod.featured_image | img_url: 'master' }}" alt="{{ prod.title }}">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
              
              <!-- زرار الزائد -->
              <button class="t-hotspot-btn" aria-label="Quick view">+</button>
            </div>

            <!-- بوب أب المنتج الخاص بهذا الكارد -->
            <div class="t-quick-popup" style="display: none;">
              <button class="t-close-popup">&times;</button>
              <div class="t-popup-content">
                <div class="t-popup-img">
                  <img src="{{ prod.featured_image | img_url: 'medium' }}" alt="{{ prod.title }}">
                </div>
                <div class="t-popup-details">
                  <h3 class="t-p-title">{{ prod.title }}</h3>
                  <p class="t-p-price">{{ prod.price | money }}</p>
                  <div class="t-p-desc">{{ prod.description | truncatewords: 20 }}</div>

                  <div class="t-p-variants" data-variants='{{ prod.variants | json }}'>
                    <!-- سيتم توليد الفاريانتس ديناميكياً بالـ JS -->
                  </div>

                  <button class="t-add-to-cart-btn" data-variant-id="{{ prod.selected_or_first_available_variant.id }}">
                    ADD TO CART &rarr;
                  </button>
                </div>
              </div>
            </div>

          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .t-wild-section {
    padding: 60px 20px;
    background: #fff;
    font-family: sans-serif;
  }
  .t-wild-container {
    max-width: 1400px;
    margin: 0 auto;
  }
  .t-wild-title {
    font-size: 28px;
    font-weight: 400;
    margin-bottom: 30px;
    color: #111;
  }
  .t-wild-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 20px;
  }
  @media screen and (min-width: 768px) {
    .t-wild-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .t-wild-card {
    position: relative;
    overflow: hidden;
  }
  .t-wild-image-wrapper {
    position: relative;
    width: 100%;
    height: 450px;
  }
  .t-wild-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .t-hotspot-btn {
    position: absolute;
    bottom: 30px;
    right: 30px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.8);
    border: none;
    font-size: 20px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s;
  }
  .t-hotspot-btn:hover {
    background: #fff;
  }

  /* تصميم البوب أب */
  .t-quick-popup {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 90%;
    max-width: 380px;
    background: #fff;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    padding: 25px;
    z-index: 100;
    box-sizing: border-box;
  }
  .t-close-popup {
    position: absolute;
    top: 10px;
    right: 15px;
    background: none;
    border: none;
    font-size: 22px;
    cursor: pointer;
  }
  .t-popup-content {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  .t-popup-img img {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }
  .t-p-title {
    font-size: 16px;
    font-weight: 500;
    margin: 0 0 5px;
  }
  .t-p-price {
    font-size: 15px;
    color: #333;
    margin: 0 0 10px;
  }
  .t-p-desc {
    font-size: 12px;
    color: #666;
    line-height: 1.4;
    margin-bottom: 15px;
  }
  .t-add-to-cart-btn {
    width: 100%;
    background: #000;
    color: #fff;
    border: none;
    padding: 12px;
    font-size: 13px;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
    transition: background 0.3s;
  }
  .t-add-to-cart-btn:hover {
    background: #333;
  }
  .t-variant-group {
    margin-bottom: 12px;
  }
  .t-variant-label {
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 5px;
    display: block;
  }
  .t-variant-options {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .t-var-option {
    padding: 6px 12px;
    font-size: 12px;
    border: 1px solid #ddd;
    background: #fff;
    cursor: pointer;
  }
  .t-var-option.active {
    border-color: #000;
    background: #000;
    color: #fff;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const cards = document.querySelectorAll(".t-wild-card");

    cards.forEach(card => {
      const hotspot = card.querySelector(".t-hotspot-btn");
      const popup = card.querySelector(".t-quick-popup");
      const closeBtn = card.querySelector(".t-close-popup");
      const variantsContainer = card.querySelector(".t-p-variants");
      const addToCartBtn = card.querySelector(".t-add-to-cart-btn");

      if (!hotspot || !popup) return;

      // فتح البوب أب
      hotspot.addEventListener("click", () => {
        // إغلاق أي بوب أب مفتوح تاني
        document.querySelectorAll(".t-quick-popup").forEach(p => p.style.display = "none");
        popup.style.display = "block";
        renderVariants();
      });

      // إغلاق البوب أب
      closeBtn.addEventListener("click", () => {
        popup.style.display = "none";
      });

      // رندرة الفاريانتس ديناميكياً
      function renderVariants() {
        if (variantsContainer.dataset.rendered) return;
        const variantsData = JSON.parse(variantsContainer.dataset.variants);
        
        // جلب خيارات الأوبشنز (Color, Size, etc.)
        // ولتسهيل التطبيق، هنعرض الـ variants المتاحة
        let html = '';
        variantsData.forEach((variant, index) => {
          if(variant.available) {
            // لو حابب تعرضهم كأزرار بسيطة
          }
        });
        
        variantsContainer.dataset.rendered = "true";
      }

      // وظيفة الإضافة للسلة + شرط الجاكيت الـ Soft Winter Jacket
      addToCartBtn.addEventListener("click", () => {
        const variantId = addToCartBtn.dataset.variantId;
        
        // بيانات الإضافة للسلة
        let itemsToAdd = [{ id: variantId, quantity: 1 }];

        // هنا بنشيك لو الفاريانت المحدد هو Black و Medium (كمثال تطبيقي للشرط)
        // أو هنبعت طلب الإضافة للسلة عبر Shopify Ajax API
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: itemsToAdd })
        })
        .then(response => response.json())
        .then(data => {
          alert("Added to cart successfully!");
          popup.style.display = "none";
        })
        .catch((error) => {
          console.error('Error:', error);
        });
      });
    });
  });
</script>